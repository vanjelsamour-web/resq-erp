generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum MedicineStatus {
  ACTIVE
  INACTIVE
}

model Patient {
  id           String        @id @default(cuid())
  patientNo    String        @unique @db.VarChar(20)
  firstName    String        @db.VarChar(100)
  lastName     String        @db.VarChar(100)
  dateOfBirth  DateTime?
  phone        String?       @db.VarChar(30)
  email        String?       @db.VarChar(255)
  status       PatientStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cases        Case[]
  visits       Visit[]
  invoices     Invoice[]
  payments     Payment[]
  medications  PatientMedicine[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
}

model Case {
  id             String     @id @default(cuid())
  caseNo         String     @unique @db.VarChar(30)
  patientId      String
  type           String     @db.VarChar(80)
  status         CaseStatus @default(PENDING)
  amount         Decimal    @db.Decimal(12, 2)
  decisionAmount Decimal?   @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  notes          String?
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visits         Visit[]
  invoices       Invoice[]

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model Visit {
  id            String      @id @default(cuid())
  visitNo       String      @unique @db.VarChar(30)
  patientId     String
  caseId        String?
  scheduledAt   DateTime
  type          String      @db.VarChar(80)
  practitioner  String?     @db.VarChar(150)
  status        VisitStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  case          Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([patientId, scheduledAt])
  @@index([caseId])
  @@index([status])
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String        @unique @db.VarChar(40)
  patientId    String
  caseId       String?
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  amount       Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(ISSUED)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([patientId])
  @@index([caseId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id          String        @id @default(cuid())
  paymentNo   String        @unique @db.VarChar(40)
  invoiceId   String
  patientId   String
  paidAt      DateTime      @default(now())
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?       @db.VarChar(100)
  status      PaymentStatus @default(COMPLETED)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([patientId])
  @@index([paidAt])
  @@index([status])
}

model Medicine {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(200)
  strength    String?       @db.VarChar(100)
  form        String?       @db.VarChar(100)
  status      MedicineStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  patients    PatientMedicine[]

  @@index([name])
  @@index([status])
}

model PatientMedicine {
  id          String    @id @default(cuid())
  patientId   String
  medicineId  String
  prescribedAt DateTime @default(now())
  quantity    String?   @db.VarChar(100)
  dosage      String?   @db.VarChar(200)
  instructions String?
  createdAt   DateTime  @default(now())
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicine    Medicine  @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([medicineId])
  @@index([prescribedAt])
}
